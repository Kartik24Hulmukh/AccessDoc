HOST=127.0.0.1
PORT=8000
ALLOW_NETWORK_EXPOSURE=false
ALLOWED_HOSTS=127.0.0.1:8000,localhost:8000
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
SOCKET_TIMEOUT_SECONDS=15
MAX_CONCURRENT_REQUESTS=2
RATE_LIMIT_PER_MINUTE=30
REPORT_TTL_SECONDS=1800
REPORT_MAX_ITEMS=100
REPORT_MAX_BYTES=50000000
MAX_CONNECTIONS=32
LISTEN_BACKLOG=128
SHUTDOWN_GRACE_SECONDS=15
GENERATION_QUEUE_TIMEOUT_SECONDS=0.05

# Authenticated single-credential pilot (not tenant billing/quotas). Set via secrets manager.
ACCESSDOC_REQUIRE_AUTH=false
ACCESSDOC_API_KEY=
# Legacy multi-key header mode from PR #35 (ignored when ACCESSDOC_API_KEY is set).
ACCESSDOC_API_KEYS=

# AI remediation (Melious gateway). Credential via secrets manager only.
MELIOUS_API_KEY=
MAX_CONCURRENT_REMEDIATIONS=8
REMEDIATION_QUEUE_TIMEOUT_SECONDS=10
GATEWAY_BUDGET_SECONDS=40
GATEWAY_MAX_TOKENS=1024
